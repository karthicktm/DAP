# Railway-optimized Dockerfile for Flutter Web
FROM ubuntu:20.04

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Download and install Flutter
ENV FLUTTER_VERSION=3.22.3
RUN git clone https://github.com/flutter/flutter.git -b stable --depth 1 /flutter
ENV PATH="/flutter/bin:$PATH"

# Create startup script as root first
RUN echo '#!/bin/bash' > /start.sh && \
    echo 'echo "🚀 Starting web server..."' >> /start.sh && \
    echo 'echo "PORT: ${PORT:-8080}"' >> /start.sh && \
    echo 'echo "Working directory: $(pwd)"' >> /start.sh && \
    echo 'cd /app/build/web' >> /start.sh && \
    echo 'echo "Files in build/web:"' >> /start.sh && \
    echo 'ls -la' >> /start.sh && \
    echo 'echo "Starting Python HTTP server on port ${PORT:-8080}"' >> /start.sh && \
    echo 'exec python3 -m http.server ${PORT:-8080}' >> /start.sh && \
    chmod +x /start.sh

# Create non-root user for Flutter and give Flutter permissions
RUN useradd -m -u 1001 flutteruser && \
    chown -R flutteruser:flutteruser /flutter && \
    chmod -R 755 /flutter

# Set working directory
WORKDIR /app

# Copy Flutter project files and set ownership
COPY pubspec.yaml pubspec.lock ./
COPY lib ./lib
COPY web ./web
COPY assets ./assets
COPY .env ./

RUN chown -R flutteruser:flutteruser /app

# Switch to non-root user
USER flutteruser

# Pre-download Flutter dependencies
RUN flutter doctor -v
RUN flutter pub get

# Build arguments for environment variables
ARG KIE_AI_API_KEY
ARG SUPABASE_URL
ARG SUPABASE_ANON_KEY
ARG RAILWAY_STATIC_URL

# Build Flutter web app with environment variables
RUN flutter build web \
    --dart-define=KIE_AI_API_KEY=$KIE_AI_API_KEY \
    --dart-define=SUPABASE_URL=$SUPABASE_URL \
    --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY \
    --dart-define=RAILWAY_STATIC_URL=$RAILWAY_STATIC_URL \
    --release

# Expose port (Railway sets PORT dynamically)
EXPOSE 8080

# Start web server
CMD ["/start.sh"]